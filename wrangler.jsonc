{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "itunes-artwork-finder",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-01",
    "assets": {
        // Vite builds into dist/itunes-artwork-finder so asset paths match the public URL path.
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash"
    },
    "observability": {
        "enabled": true
    }
    // Routes are not set here. `npm run deploy` passes DEPLOY_ROUTES from your .env (see .env.example).
    // With no routes, Wrangler deploys to workers.dev; with routes, workers.dev stays off.
}
