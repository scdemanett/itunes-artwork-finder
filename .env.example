# Copy to .env (gitignored) and fill in to deploy on your own domain. Both are optional:
# leave them empty to deploy to <worker>.<your-subdomain>.workers.dev/itunes-artwork-finder/.

# Comma-separated Worker routes. The zone's DNS record must be proxied through Cloudflare.
DEPLOY_ROUTES=example.com/itunes-artwork-finder*,www.example.com/itunes-artwork-finder*

# Public URL of the app (with trailing slash). Used for the canonical link and social-preview tags.
VITE_SITE_URL=https://example.com/itunes-artwork-finder/
